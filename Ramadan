/* backup */
function viewBackup(){
  return head("Backup","Everything you enter stays in this browser. Copy a backup now and then, and paste it here to restore it on another device.")
    +sec("Backup and restore",null,`<div class="chips"><button class="btn pri" data-act="copy">Copy backup</button><button class="btn" data-act="restore">Restore from the box below</button></div><div style="margin-top:12px"><textarea id="bk" rows="6" aria-label="Backup text" placeholder="Paste a backup here to restore it"></textarea></div><p class="lede" id="bmsg" role="status"></p>`)
    +sec("Sample data and reset",null,`<p class="lede" style="margin:0 0 12px">Fill the first 12 days with example entries to see how a used journal looks. This replaces what you have entered.</p><div class="chips"><button class="btn" data-act="sample">Fill with sample data</button><button class="btn" data-act="wipe">Erase everything</button></div>`)+FOOT;
}
function msg(t){const e=$("#bmsg");if(e)e.textContent=t}
function copyBackup(){
  const t=JSON.stringify(S),ta=$("#bk");if(ta)ta.value=t;
  const sel=()=>{if(ta){ta.focus();ta.select()}};
  let can=false;try{can=!!(navigator.clipboard&&navigator.clipboard.writeText)}catch(e){}
  if(can){navigator.clipboard.writeText(t).then(()=>msg("Backup copied. Paste it somewhere safe, like a notes app."),()=>{sel();msg("Your browser blocked copying. The backup is in the box, so select it and copy it yourself.")})}
  else{sel();msg("The backup is in the box. Select it and copy it yourself.")}
}
function restore(){
  const ta=$("#bk");let d;
  try{d=JSON.parse(ta.value)}catch(e){msg("That doesn't look like a backup. Paste the full text you copied earlier.");return}
  if(!d||typeof d!=="object"||Array.isArray(d)||!d.days){msg("That doesn't look like a backup from this journal.");return}
  S=merge(d);save();render(false);msg("Backup restored.");
}
function sample(){
  let seed=11;const r=()=>{seed=(seed*9301+49297)%233280;return seed/233280};
  const meals=[["Oats with dates and tea","Lentil soup, dates, grilled chicken, salad"],["Eggs, toast and yogurt","Dates, fruit chaat, chicken rice"],["Labneh wrap and a banana","Samosas, chickpea curry, rice"],["Overnight oats","Dates, vegetable soup, pasta bake"]];
  const tasks=["Revise chapter 4","Reply to emails","Call a family member"];
  const grat=["Good health","Time with family","A quiet hour with the Quran"];
  S.days={};
  for(let d=1;d<=12;d++){
    const x={p:{},x:{},dh:{},top:{},gr:{}};
    PRAYERS.forEach(p=>{x.p[p[0]]=r()>0.12});
    HABITS.forEach(h=>{x.x[h[0]]=r()>0.42});
    x.pages=String(Math.round(14+r()*9));
    DHIKR.forEach(k=>{x.dh[k[0]]=Math.round(k[2]*(0.4+r()*0.7))});
    const m=meals[d%meals.length];x.suhoor=m[0];x.iftar=m[1];
    for(let i=0;i<3;i++){x.top[i]={t:tasks[i],d:r()>0.35};x.gr[i]=grat[i]}
    S.days[d]=x;
  }
  S.juz={};for(let j=1;j<=12;j++)S.juz[j]=true;
  S.goals.p1="Pray every prayer on time";S.goals.p2="Finish the Quran once";S.goals.p3="Give charity every Friday";
  S.groc=[{t:"Dates",d:true},{t:"Rice",d:true},{t:"Chickpeas",d:false},{t:"Yogurt",d:false}];
  S.chlog=[{date:iso(dateOf(5)),desc:"Local food bank",amt:"25"},{date:iso(dateOf(9)),desc:"Masjid fund",amt:"50"}];
  save();
}

/* actions */
function act(a,el){
  if(a==="prev"){ui.day=Math.max(1,ui.day-1);render(true)}
  else if(a==="next"){ui.day=Math.min(30,ui.day+1);render(true)}
  else if(a==="today"){const i=todayIdx();ui.day=(i>=1&&i<=30)?i:1;render(true)}
  else if(a==="pick"){ui.day=+el.dataset.day;go("today")}
  else if(a==="dh"){
    const k="days."+ui.day+".dh."+el.dataset.key,row=el.closest(".counter"),tg=+row.dataset.t;
    const nv=Math.max(0,num(get(k))+Number(el.dataset.d));
    set(k,nv);row.querySelector(".cn").textContent=nv;row.querySelector(".bar i").style.width=Math.min(100,nv/tg*100)+"%";
  }
  else if(a==="addg"){const i=$("#gnew"),t=i?i.value.trim():"";if(!t)return;S.groc.push({t:t,d:false});save();render(false)}
  else if(a==="delg"){S.groc.splice(+el.dataset.i,1);save();render(false)}
  else if(a==="addc"){S.chlog.push({date:"",desc:"",amt:""});save();render(false)}
  else if(a==="delc"){S.chlog.splice(+el.dataset.i,1);save();render(false)}
  else if(a==="addgift"){S.eid.gifts.push({who:"",gift:"",done:false});save();render(false)}
  else if(a==="delgift"){S.eid.gifts.splice(+el.dataset.i,1);save();render(false)}
  else if(a==="copy")copyBackup();
  else if(a==="restore")restore();
  else if(a==="sample"){sample();render(false);msg("Sample data added to days 1 to 12.")}
  else if(a==="wipe"){
    if(!ui.wipe){ui.wipe=true;el.textContent="Click again to erase everything";return}
    ui.wipe=false;S=fresh();save();ui.day=1;render(true);msg("Everything has been erased.");
  }
}
function refresh(){
  const P="days."+ui.day,st=stats();
  let e=$("#ringw");if(e)e.innerHTML=ringHTML();
  e=$("#m-pr");if(e)e.textContent=PRAYERS.filter(p=>get(P+".p."+p[0])).length+" of 5";
  e=$("#m-qp");if(e)e.textContent=fmtN(st.pages)+" of "+MUSHAF+" pages this month";
  e=$("#m-juz");if(e)e.textContent=Object.keys(S.juz).filter(k=>S.juz[k]).length+" of 30";
  e=$("#m-pg");if(e)e.textContent=fmtN(st.pages)+" of "+MUSHAF;
  e=$("#m-pb");if(e)e.style.width=Math.min(100,st.pages/MUSHAF*100)+"%";
  e=$("#m-ch");if(e)e.textContent=chTotal();
  e=$("#m-z");if(e)e.innerHTML=zakatHTML();
  updateMonth();
}
function onField(e){
  const el=e.target;
  if(!el||!el.dataset||!el.dataset.k)return;
  if(el.dataset.re&&e.type!=="change")return;
  const v=el.type==="checkbox"?el.checked:el.value;
  if(el.dataset.k==="start"&&!v)return;
  set(el.dataset.k,v);
  if(el.dataset.re)render(false);else refresh();
}

/* rendering and routing */
function render(top){
  const y=window.scrollY;
  const fn={today:viewToday,month:viewMonth,quran:viewQuran,goals:viewGoals,duas:viewDuas,nights:viewNights,lists:viewLists,eid:viewEid,backup:viewBackup}[ui.view]||viewToday;
  $("#app").innerHTML=fn();
  $("#nav").innerHTML=VIEWS.map(v=>`<a href="#${v[0]}" data-v="${v[0]}"${v[0]===ui.view?' aria-current="page"':""}>${esc(v[1])}</a>`).join("");
  if(top){ui.wipe=false;window.scrollTo(0,0);try{const c=$("#nav [aria-current]");if(c)c.scrollIntoView({inline:"center",block:"nearest"})}catch(err){}}
  else window.scrollTo(0,y);
}
function go(v){ui.view=v;try{if(location.hash!=="#"+v)location.hash=v}catch(e){}render(true)}
function route(){
  const h=(location.hash||"").slice(1);
  const v=VIEWS.some(x=>x[0]===h)?h:ui.view;
  if(v!==ui.view||!ui.ready){ui.view=v;ui.ready=true;render(true)}
}
const app=$("#app");
app.addEventListener("input",onField);
app.addEventListener("change",onField);
app.addEventListener("click",e=>{const b=e.target.closest("[data-act]");if(b)act(b.dataset.act,b)});
app.addEventListener("keydown",e=>{if(e.key==="Enter"&&e.target.id==="gnew"){e.preventDefault();act("addg",e.target)}});
$("#nav").addEventListener("click",e=>{const a=e.target.closest("a[data-v]");if(a){e.preventDefault();go(a.dataset.v)}});
window.addEventListener("hashchange",route);
