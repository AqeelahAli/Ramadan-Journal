<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Ramadan Journal</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700&family=Instrument+Serif:ital@0;1&display=swap">
<style>
/* Layout: one calm column under a sticky masthead with section tabs. Each view is a stack of ruled sections.
   The single bold moment is the day ring, 30 ticks for 30 days, filling in gold as the month goes on. */
:root{
  color-scheme:light;
  --bg:#ECEFE8; --surface:#F6F8F3; --ink:#18271F; --ink-soft:#56665C; --line:#CDD5C8; --tick:#BAC4B5;
  --accent:#2E4A3A; --on-accent:#F3F6EF; --sage:#7F9E87; --gold:#B8902F; --gold-ink:#7C5C0E;
  --display:"Instrument Serif",Georgia,"Times New Roman",serif;
  --body:"DM Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --arabic:"Amiri","Noto Naskh Arabic","Geeza Pro","Traditional Arabic",serif;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    color-scheme:dark;
    --bg:#111913; --surface:#18221B; --ink:#E6ECE2; --ink-soft:#A0B1A5; --line:#2C3C32; --tick:#3F5547;
    --accent:#A8CBB0; --on-accent:#0F1B14; --sage:#7FA088; --gold:#D4B05A; --gold-ink:#D9B965;
  }
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --bg:#111913; --surface:#18221B; --ink:#E6ECE2; --ink-soft:#A0B1A5; --line:#2C3C32; --tick:#3F5547;
  --accent:#A8CBB0; --on-accent:#0F1B14; --sage:#7FA088; --gold:#D4B05A; --gold-ink:#D9B965;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.55 var(--body);
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:0 48px}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--bg)}
.col{max-width:760px;margin:0 auto}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

/* masthead */
.mast{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--bg);border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0 2px}
.logo{display:flex;align-items:center;gap:8px;margin:0;font:400 26px/1 var(--display)}
.logo svg{width:22px;height:22px;color:var(--gold)}
.ar-s{font:400 24px/1.4 var(--arabic);color:var(--gold-ink)}
.nav{display:flex;gap:2px;overflow-x:auto;scrollbar-width:none;margin:0 -6px}
.nav::-webkit-scrollbar{display:none}
.nav a{flex:none;padding:10px 12px;color:var(--ink-soft);text-decoration:none;font-weight:500;font-size:15px;border-bottom:2px solid transparent;white-space:nowrap}
.nav a:hover{color:var(--ink)}
.nav a[aria-current]{color:var(--ink);border-bottom-color:var(--gold)}

/* type */
h1{font:400 clamp(32px,6vw,42px)/1.05 var(--display);margin:0;text-wrap:balance}
h2{font:400 24px/1.15 var(--display);margin:0;text-wrap:balance}
h3{font:700 12px/1.3 var(--body);letter-spacing:.1em;text-transform:uppercase;color:var(--gold-ink);margin:0 0 8px}
.lede{color:var(--ink-soft);margin:8px 0 0;max-width:62ch}
.kicker{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--gold-ink);font-weight:700;margin:0 0 8px}
.meta{font-size:13px;color:var(--ink-soft);font-variant-numeric:tabular-nums}
.vh{padding:24px 0 18px}

/* sections */
.blk{padding:22px 0;border-top:1px solid var(--line)}
.bh{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:12px}
.stack{display:grid;gap:8px;margin-bottom:10px}
.two{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
.gl{margin-bottom:14px}
.foot{border-top:1px solid var(--line);margin-top:24px;padding-top:16px;font-size:13px;color:var(--ink-soft)}

/* controls */
.btn{font:500 14px var(--body);padding:9px 14px;border-radius:10px;border:1px solid var(--line);background:transparent;color:var(--ink);cursor:pointer}
.btn:hover{border-color:var(--sage)}
.btn.pri{background:var(--accent);color:var(--on-accent);border-color:var(--accent)}
.btn:disabled{opacity:.4;cursor:default}
.btn:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,summary:focus-visible,.cell:focus-visible,.cb:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
label.f{display:flex;flex-direction:column;gap:5px;font-size:12px;letter-spacing:.04em;color:var(--ink-soft)}
input[type=text],input[type=number],input[type=time],input[type=date],textarea{width:100%;font:400 16px var(--body);color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:10px 12px;min-width:0}
input::placeholder,textarea::placeholder{color:var(--ink-soft);opacity:.7}
textarea{resize:vertical;min-height:84px;line-height:1.5}
.row{display:flex;gap:10px;align-items:center;margin-top:10px}
.row input{flex:1}

.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{position:relative;display:inline-flex}
.chip input{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:pointer}
.chip span{padding:9px 14px;border:1px solid var(--line);border-radius:999px;font-size:15px;background:var(--surface);transition:background .15s}
.chip input:checked+span{background:var(--accent);color:var(--on-accent);border-color:var(--accent)}
.chip input:checked+span::before{content:"\2713\00a0"}
.chip input:focus-visible+span{outline:2px solid var(--gold);outline-offset:2px}

.dot{position:relative;display:inline-block;width:22px;height:22px;flex:none}
.dot input{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:pointer}
.dot span{display:block;width:100%;height:100%;border:1.5px solid var(--sage);border-radius:50%}
.dot input:checked+span{background:var(--gold);border-color:var(--gold)}
.dot input:focus-visible+span{outline:2px solid var(--gold);outline-offset:2px}
.task{display:flex;gap:10px;align-items:center;margin-top:8px}
.task input[type=text]{flex:1}

/* today */
.hero{display:flex;flex-wrap:wrap;gap:20px 28px;align-items:center;padding:20px;margin:18px 0 22px;background:var(--surface);border:1px solid var(--line);border-radius:18px}
.ringw{position:relative;width:148px;height:148px;flex:none}
.ringw svg{display:block;width:100%;height:100%}
.tk{stroke:var(--tick);stroke-width:2.4;stroke-linecap:round}
.tk.mid{stroke:var(--sage)}
.tk.hi{stroke:var(--gold)}
.tk.cur{stroke:var(--accent);stroke-width:3.8}
.rc{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1}
.rc b{font:400 52px/1 var(--display);font-variant-numeric:tabular-nums}
.rc span{font-size:12px;letter-spacing:.06em;color:var(--ink-soft);margin-top:4px}
.hinfo{flex:1 1 240px;min-width:0}
.daynav{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0}
.times{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.dq{font:italic 400 26px/1.3 var(--display);margin:0;max-width:34ch;text-wrap:balance}

.counter{display:grid;grid-template-columns:1fr auto;gap:8px 12px;align-items:center;padding:12px 0;border-top:1px dashed var(--line)}
.counter:first-of-type{border-top:0;padding-top:0}
.cname{font-weight:500}
.ctl{display:flex;align-items:center;gap:8px}
.cn{min-width:3ch;text-align:right;font:400 30px/1 var(--display);font-variant-numeric:tabular-nums}
.cb{width:40px;height:40px;border-radius:50%;border:1px solid var(--line);background:var(--surface);color:var(--ink);font:400 20px/1 var(--body);cursor:pointer}
.cb.plus{width:48px;height:48px;background:var(--accent);color:var(--on-accent);border-color:var(--accent)}
.bar,.pb{height:5px;border-radius:3px;background:var(--line);overflow:hidden}
.bar{grid-column:1/-1}
.pb{height:8px;border-radius:4px}
.bar i,.pb i{display:block;height:100%;background:var(--gold)}

/* month */
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:14px}
.stat b{display:block;font:400 36px/1 var(--display);font-variant-numeric:tabular-nums}
.stat span{font-size:13px;color:var(--ink-soft)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(92px,1fr));gap:8px}
.cell{display:flex;flex-direction:column;gap:2px;min-width:0;text-align:left;padding:10px 10px 8px;border:1px solid var(--line);border-radius:12px;font:inherit;color:var(--ink);cursor:pointer;
  background:var(--surface);background:color-mix(in srgb,var(--gold) calc(var(--s,0)*45%),var(--surface))}
.cell b{font:400 28px/1 var(--display)}
.cell small{font-size:11px;color:var(--ink-soft)}
.cell.cur{outline:2px solid var(--accent);outline-offset:1px}
.scroll{overflow-x:auto;border:1px solid var(--line);border-radius:12px}
.trk{border-collapse:collapse;min-width:100%;font-size:12px}
.trk th,.trk td{padding:6px 5px;text-align:center;border-bottom:1px solid var(--line)}
.trk thead th{font-weight:500;color:var(--ink-soft);font-variant-numeric:tabular-nums}
.trk th.rl{position:sticky;left:0;z-index:1;background:var(--bg);text-align:left;padding:6px 10px;white-space:nowrap;font-weight:500;color:var(--ink);border-right:1px solid var(--line)}
.trk tr:last-child th,.trk tr:last-child td{border-bottom:0}
.trk .dot{width:16px;height:16px;vertical-align:middle}

/* quran, duas, nights */
.juz{display:grid;grid-template-columns:repeat(auto-fill,minmax(88px,1fr));gap:8px}
.juz .chip{display:flex}
.juz .chip span{display:block;width:100%;text-align:center;border-radius:12px;padding:10px 6px}
.ar{font:400 28px/1.9 var(--arabic);margin:4px 0}
.tr{font-style:italic;color:var(--ink-soft);margin:2px 0}
.mn{margin:6px 0 0}
.duapair{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:28px}
details summary{cursor:pointer;font-weight:500;color:var(--accent)}
.dl{list-style:none;margin:12px 0;padding:0}
.dl li{padding:10px 0;border-top:1px dashed var(--line)}
.night{padding:14px 0;border-top:1px dashed var(--line)}
.night:first-of-type{border-top:0;padding-top:0}
.nh{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 12px;margin-bottom:10px}
.nh b{font:400 24px/1.1 var(--display)}
.odd .nh b{color:var(--gold-ink)}
.tag{font-size:11px;letter-spacing:.1em;text-transform:uppercase;font-weight:700;color:var(--gold-ink)}

/* lists */
.crow{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:10px}
.crow input{flex:1 1 130px;width:auto}
.crow input[type=date]{flex:0 1 160px}
.crow .dot{flex:none}

@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>

<div class="col">
  <header class="mast">
    <div class="brand">
      <p class="logo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15.5 3.2a9 9 0 1 0 5.3 13.6A7.5 7.5 0 0 1 15.5 3.2z" fill="currentColor"/></svg>Ramadan Journal</p>
      <span class="ar-s" lang="ar" dir="rtl">رمضان كريم</span>
    </div>
    <nav class="nav" id="nav" aria-label="Sections"></nav>
  </header>
  <main id="app"></main>
</div>

<script>
(function(){
"use strict";
const KEY="ramadan-journal-v1";
const MAXS=12, MUSHAF=604;
const VIEWS=[["today","Today"],["month","Month"],["quran","Quran"],["goals","Goals"],["duas","Duas"],["nights","Last 10 nights"],["lists","Lists"],["eid","Eid"],["backup","Backup"]];
const PRAYERS=[["fajr","Fajr"],["dhuhr","Dhuhr"],["asr","Asr"],["maghrib","Maghrib"],["isha","Isha"]];
const HABITS=[["taraweeh","Taraweeh","Taraweeh"],["tahajjud","Tahajjud or Qiyam","Tahajjud"],["sunnah","Sunnah prayers","Sunnah"],["adhkar","Morning and evening adhkar","Adhkar"],["charity","Charity given","Charity"],["kind","Act of kindness","Kindness"]];
const DHIKR=[["sub","SubhanAllah",33],["hamd","Alhamdulillah",33],["akbar","Allahu Akbar",33],["istigh","Astaghfirullah",100],["salawat","Salawat on the Prophet",100]];
const DUAS=[
["Quran 14:40","My Lord, make me one who keeps up prayer, and my children too. Our Lord, accept my prayer."],
["Quran 2:286","Our Lord, do not burden us with more than we can bear. Pardon us, forgive us, and have mercy on us."],
["Quran 3:8","Our Lord, do not let our hearts turn away after You have guided us, and grant us mercy from You."],
["Quran 3:16","Our Lord, we believe. Forgive our sins and protect us from the punishment of the Fire."],
["Quran 3:191","Our Lord, You created all this with purpose. Glory be to You. Protect us from the punishment of the Fire."],
["Quran 3:193","Our Lord, we heard a caller invite us to faith, and we believed. Forgive our sins, erase our wrongs, and let us die among the righteous."],
["Quran 7:23","Our Lord, we have wronged ourselves. If You do not forgive us and have mercy on us, we will be among the lost."],
["Quran 7:126","Our Lord, pour patience over us and let us die in submission to You."],
["Quran 14:38","Our Lord, You know what we hide and what we show. Nothing on earth or in heaven is hidden from Allah."],
["Quran 2:201","Our Lord, give us good in this world and good in the next, and protect us from the punishment of the Fire."],
["Quran 14:41","Our Lord, forgive me, my parents, and the believers on the Day the reckoning is established."],
["Quran 18:10","Our Lord, grant us mercy from You and make our affairs turn out rightly."],
["Quran 40:7","Our Lord, Your mercy and knowledge encompass everything. Forgive those who turn to You and follow Your path."],
["Quran 66:8","Our Lord, perfect our light for us and forgive us. You have power over all things."],
["Quran 60:5","Our Lord, do not make us a trial for those who disbelieve, and forgive us. You are the Almighty, the Wise."],
["Quran 12:101","You are my protector in this world and the next. Let me die in submission to You and join me with the righteous."],
["Quran 20:25-28","My Lord, open up my chest, make my task easy for me, and loosen the knot in my tongue so that they understand my words."],
["Quran 28:24","My Lord, I am in need of whatever good You send down to me."],
["Quran 27:19","My Lord, inspire me to be grateful for the blessings You gave me and my parents, and to do good work that pleases You."],
["Quran 20:114","My Lord, increase me in knowledge."],
["Quran 3:38","My Lord, grant me good offspring from You. You are the One who hears every prayer."],
["Quran 25:74","Our Lord, give us joy in our spouses and children, and make us an example for those who are mindful of You."],
["Quran 23:118","My Lord, forgive and have mercy. You are the best of those who show mercy."],
["Quran 17:80","My Lord, let me enter and leave in truth, and grant me support from You."],
["Quran 21:87","There is no god but You. Glory be to You. I have been among the wrongdoers."],
["Quran 21:83","My Lord, hardship has touched me, and You are the most merciful of the merciful."],
["Quran 2:127","Our Lord, accept this from us. You are the All-Hearing, the All-Knowing."],
["Quran 59:10","Our Lord, forgive us and our brothers and sisters who came before us in faith, and keep resentment out of our hearts."],
["Quran 2:250","Our Lord, pour patience upon us, make our steps firm, and help us."],
["Quran 46:15","My Lord, inspire me to be thankful for Your favours, to do good that pleases You, and to make my children righteous. I turn to You."]
];

/* helpers */
const $=s=>document.querySelector(s);
const esc=s=>String(s==null?"":s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
const num=v=>{const n=parseFloat(v);return isFinite(n)?n:0};
const fmtN=n=>n.toLocaleString(undefined,{maximumFractionDigits:2});
const iso=dt=>dt.getFullYear()+"-"+String(dt.getMonth()+1).padStart(2,"0")+"-"+String(dt.getDate()).padStart(2,"0");

/* state, saved in this browser only */
function fresh(){return {start:"2027-02-08",name:"",days:{},juz:{},goals:{},watch:{},duas:{},nights:{},eid:{check:{},gifts:[],plan:""},groc:[],chlog:[],zakat:{},qnotes:""}}
function load(){let raw=null;try{raw=localStorage.getItem(KEY)}catch(e){}let d=null;try{d=raw?JSON.parse(raw):null}catch(e){}return d&&typeof d==="object"&&!Array.isArray(d)?d:{}}
function merge(d){
  const f=fresh();for(const k in d){f[k]=d[k]}
  ["days","juz","goals","watch","duas","nights","zakat"].forEach(k=>{if(!f[k]||typeof f[k]!=="object"||Array.isArray(f[k]))f[k]={}});
  if(!f.eid||typeof f.eid!=="object")f.eid={};
  if(!f.eid.check)f.eid.check={};
  if(!Array.isArray(f.eid.gifts))f.eid.gifts=[];
  if(!Array.isArray(f.groc))f.groc=[];
  if(!Array.isArray(f.chlog))f.chlog=[];
  return f;
}
let S=merge(load());
function save(){try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}}
function get(path){return path.split(".").reduce((o,k)=>o==null?undefined:o[k],S)}
function set(path,val){
  const ks=path.split(".");let o=S;
  for(let i=0;i<ks.length-1;i++){const k=ks[i];if(o[k]==null||typeof o[k]!=="object")o[k]={};o=o[k]}
  o[ks[ks.length-1]]=val;save();
}

/* dates */
const parseISO=s=>{const m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(s||"");return m?new Date(+m[1],+m[2]-1,+m[3]):new Date(2027,1,8)};
const addDays=(d,n)=>new Date(d.getFullYear(),d.getMonth(),d.getDate()+n);
const dateOf=d=>addDays(parseISO(S.start),d-1);
const fd=(dt,o)=>dt.toLocaleDateString(undefined,o);
function todayIdx(){const t=new Date();const t0=new Date(t.getFullYear(),t.getMonth(),t.getDate());return Math.round((t0-parseISO(S.start))/86400000)+1}

const ui={view:"today",day:1,ready:false,wipe:false};
(function(){const i=todayIdx();ui.day=(i>=1&&i<=30)?i:1})();

/* progress */
function score(d){
  const x=S.days[d];if(!x)return 0;let n=0;
  PRAYERS.forEach(p=>{if(x.p&&x.p[p[0]])n++});
  HABITS.forEach(h=>{if(x.x&&x.x[h[0]])n++});
  if(num(x.pages)>0)n++;
  return n;
}
function stats(){
  let all5=0,pages=0,tar=0,cha=0;
  for(let d=1;d<=30;d++){
    const x=S.days[d];if(!x)continue;
    if(PRAYERS.every(p=>x.p&&x.p[p[0]]))all5++;
    pages+=num(x.pages);
    if(x.x&&x.x.taraweeh)tar++;
    if(x.x&&x.x.charity)cha++;
  }
  return {all5,pages,tar,cha};
}

/* markup helpers */
const chk=(path,label)=>`<label class="chip"><input type="checkbox" data-k="${path}"${get(path)?" checked":""}><span>${esc(label)}</span></label>`;
const dot=(path,label)=>`<label class="dot"><input type="checkbox" data-k="${path}"${get(path)?" checked":""} aria-label="${esc(label)}"><span></span></label>`;
const txt=(path,label,ph)=>`<input type="text" data-k="${path}" value="${esc(get(path))}" placeholder="${esc(ph||"")}" aria-label="${esc(label)}">`;
const area=(path,label,ph,rows)=>`<textarea data-k="${path}" rows="${rows||3}" placeholder="${esc(ph||"")}" aria-label="${esc(label)}">${esc(get(path))}</textarea>`;
const numin=(path,label,ph)=>`<input type="number" inputmode="decimal" min="0" step="any" data-k="${path}" value="${esc(get(path))}" placeholder="${esc(ph||"")}" aria-label="${esc(label)}">`;
const tm=(path,label)=>`<label class="f">${esc(label)}<input type="time" data-k="${path}" value="${esc(get(path))}"></label>`;
const sec=(title,meta,body,id)=>`<section class="blk"><div class="bh"><h2>${esc(title)}</h2>${meta!=null?`<span class="meta"${id?` id="${id}"`:""}>${esc(meta)}</span>`:""}</div>${body}</section>`;
const head=(title,lede)=>`<div class="vh"><h1>${esc(title)}</h1>${lede?`<p class="lede">${esc(lede)}</p>`:""}</div>`;
const FOOT=`<p class="foot">Your entries are saved on this device, in this browser. Use the Backup tab to keep a copy.</p>`;

/* today */
function ringHTML(){
  let t="";
  for(let i=1;i<=30;i++){
    const a=(i-1)/30*2*Math.PI-Math.PI/2;
    const r1=44,r2=i===ui.day?58:54,c=Math.cos(a),s=Math.sin(a);
    const sc=score(i);
    const cls=i===ui.day?"cur":(sc>=9?"hi":(sc>0?"mid":""));
    t+=`<line class="tk ${cls}" x1="${(60+r1*c).toFixed(1)}" y1="${(60+r1*s).toFixed(1)}" x2="${(60+r2*c).toFixed(1)}" y2="${(60+r2*s).toFixed(1)}"/>`;
  }
  return `<svg viewBox="0 0 120 120" role="img" aria-label="Day ${ui.day} of 30">${t}</svg><div class="rc"><b>${ui.day}</b><span>of 30</span></div>`;
}
function viewToday(){
  const d=ui.day,P="days."+d,dt=dateOf(d),ti=todayIdx(),st=stats();
  let status="";
  if(ti<1)status="Ramadan begins in "+(1-ti)+(1-ti===1?" day":" days");
  else if(ti>30)status="Ramadan has ended";
  else if(ti===d)status="Today";
  const du=DUAS[d-1];
  const pc=PRAYERS.filter(p=>get(P+".p."+p[0])).length;
  const hero=`<section class="hero"><div class="ringw" id="ringw">${ringHTML()}</div><div class="hinfo">
    <p class="kicker">${d} Ramadan${status?" · "+esc(status):""}</p>
    <h1>${esc(fd(dt,{weekday:"long",month:"long",day:"numeric"}))}</h1>
    <div class="daynav"><button class="btn" data-act="prev"${d<=1?" disabled":""}>Previous day</button><button class="btn" data-act="next"${d>=30?" disabled":""}>Next day</button>${ti>=1&&ti<=30&&ti!==d?`<button class="btn pri" data-act="today">Jump to today</button>`:""}</div>
    <div class="times">${tm(P+".sTime","Suhoor ends (Fajr)")}${tm(P+".iTime","Iftar (Maghrib)")}</div></div></section>`;
  const dua=`<section class="blk"><p class="kicker">Dua of the day · ${esc(du[0])}</p><p class="dq">${esc(du[1])}</p></section>`;
