  const quran=sec("Quran today",fmtN(st.pages)+" of "+MUSHAF+" pages this month",`<label class="f" style="max-width:200px">Pages read today${numin(P+".pages","Pages read today","0")}</label><p class="lede">About 20 pages a day completes the ${MUSHAF}-page Madinah Mushaf in 30 days.</p>`,"m-qp");
  const dh=sec("Dhikr",null,DHIKR.map(r=>{
    const c=num(get(P+".dh."+r[0]));
    return `<div class="counter" data-t="${r[2]}"><div><span class="cname">${esc(r[1])}</span> <span class="meta">target ${r[2]}</span></div>
      <div class="ctl"><button class="cb" data-act="dh" data-key="${r[0]}" data-d="-1" aria-label="Subtract one from ${esc(r[1])}">&minus;</button><span class="cn">${c}</span><button class="cb plus" data-act="dh" data-key="${r[0]}" data-d="1" aria-label="Add one to ${esc(r[1])}">+</button></div>
      <div class="bar"><i style="width:${Math.min(100,c/r[2]*100)}%"></i></div></div>`;
  }).join(""));
  const tasks=sec("Top three for today",null,[0,1,2].map(i=>`<div class="task">${dot(P+".top."+i+".d","Done: task "+(i+1))}${txt(P+".top."+i+".t","Task "+(i+1),i===0?"Assignment, project or errand":"")}</div>`).join(""));
  const meals=sec("Meals",null,`<div class="two"><label class="f">Suhoor${txt(P+".suhoor","Suhoor meal","What are you eating before Fajr?")}</label><label class="f">Iftar${txt(P+".iftar","Iftar meal","Dates, water, then...")}</label></div>`);
  const refl=sec("Gratitude and reflection",null,`<div class="stack">${[0,1,2].map(i=>txt(P+".gr."+i,"Grateful for "+(i+1),i===0?"Three things I am grateful for today":"")).join("")}</div>${area(P+".reflect","Reflection","How did today go? What do I want to do better tomorrow?",4)}`);
  return hero+dua+prayers+worship+quran+dh+tasks+meals+refl+FOOT;
}

/* month */
function cellHTML(d){
  const s=score(d);
  return `<button class="cell${d===ui.day?" cur":""}" data-act="pick" data-day="${d}" style="--s:${(s/MAXS).toFixed(2)}" aria-label="Day ${d}, ${s} of ${MAXS} done"><b>${d}</b><small>${esc(fd(dateOf(d),{month:"short",day:"numeric"}))}</small><small class="sc">${s}/${MAXS}</small></button>`;
}
function statsHTML(st){
  return `<div class="stat"><b>${st.all5}</b><span>days with all 5 prayers</span></div><div class="stat"><b>${st.tar}</b><span>Taraweeh nights</span></div><div class="stat"><b>${fmtN(st.pages)}</b><span>Quran pages read</span></div><div class="stat"><b>${st.cha}</b><span>days with charity</span></div>`;
}
function trackerHTML(){
  const rows=PRAYERS.map(p=>["p."+p[0],p[1]]).concat(HABITS.map(h=>["x."+h[0],h[2]]));
  let hd=`<tr><th class="rl"><span class="sr">Habit</span></th>`;
  for(let d=1;d<=30;d++)hd+=`<th>${d}</th>`;
  hd+="</tr>";
  const body=rows.map(r=>{
    let t=`<tr><th class="rl">${esc(r[1])}</th>`;
    for(let d=1;d<=30;d++)t+=`<td>${dot("days."+d+"."+r[0],r[1]+", day "+d)}</td>`;
    return t+"</tr>";
  }).join("");
  return `<div class="scroll"><table class="trk"><thead>${hd}</thead><tbody>${body}</tbody></table></div>`;
}
function viewMonth(){
  let cells="";for(let d=1;d<=30;d++)cells+=cellHTML(d);
  return head("Month","Open any day, or tick habits straight into the tracker at the bottom.")
    +sec("Dates",null,`<label class="f" style="max-width:260px">Ramadan begins<input type="date" data-k="start" data-re="1" value="${esc(S.start)}"></label><p class="lede">The start date depends on the moon sighting where you live. Change it and every date in the journal moves with it.</p>`)
    +sec("This month",null,`<div class="stats" id="m-stats">${statsHTML(stats())}</div>`)
    +sec("30 days",null,`<div class="grid">${cells}</div>`)
    +sec("Habit tracker",null,trackerHTML())+FOOT;
}
function updateMonth(){
  const e=$("#m-stats");if(e)e.innerHTML=statsHTML(stats());
  document.querySelectorAll(".cell").forEach(c=>{
    const d=+c.dataset.day,s=score(d);
    c.style.setProperty("--s",(s/MAXS).toFixed(2));
    const sc=c.querySelector(".sc");if(sc)sc.textContent=s+"/"+MAXS;
  });
}

